{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Recorded frog species richness across Australian states and territories.",
  "title": {
    "text": "Recorded Frog Species Richness Across Australia",
    "subtitle": "Number of distinct frog species recorded per state/territory, 2017–2024",
    "fontSize": 15,
    "subtitleFontSize": 11,
    "fontWeight": "bold",
    "anchor": "start",
    "color": "#173D3B",
    "offset": 12
  },
  "width": "container",
  "height": 580,
  "data": {
    "url": "data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 720
  },
  "transform": [
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/species_by_state.csv"
        },
        "key": "state",
        "fields": [
          "species_count"
        ]
      }
    },
    {
      "lookup": "properties.STATE_NAME",
      "from": {
        "data": {
          "url": "data/state_land_areas.csv"
        },
        "key": "state",
        "fields": [
          "area_km2"
        ]
      }
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "geoshape",
        "stroke": "#173D3B",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "species_count",
          "type": "quantitative",
          "title": "Distinct species",
          "scale": {
            "range": [
              "#E8F3DC",
              "#B7D9B0",
              "#73B69B",
              "#32877E",
              "#154C52"
            ],
            "zero": false,
            "unknown": "#E5E7EB"
          },
          "legend": {
            "orient": "right",
            "gradientLength": 220,
            "gradientThickness": 15,
            "titleFontSize": 12,
            "labelFontSize": 11,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Distinct species",
            "format": ",.0f"
          },
          {
            "field": "area_km2",
            "type": "quantitative",
            "title": "Land area (km²)",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "WA",
            "lon": 121,
            "lat": -26,
            "align": "center"
          },
          {
            "state": "NT",
            "lon": 133,
            "lat": -20,
            "align": "center"
          },
          {
            "state": "SA",
            "lon": 135,
            "lat": -30,
            "align": "center"
          },
          {
            "state": "QLD",
            "lon": 144,
            "lat": -22,
            "align": "center"
          },
          {
            "state": "NSW",
            "lon": 147,
            "lat": -32,
            "align": "center"
          },
          {
            "state": "VIC",
            "lon": 144,
            "lat": -37,
            "align": "center"
          },
          {
            "state": "TAS",
            "lon": 147,
            "lat": -42,
            "align": "center"
          },
          {
            "state": "ACT",
            "lon": 150.3,
            "lat": -35.6,
            "align": "left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#FFFFFF",
        "opacity": 1,
        "stroke": "#173D35",
        "strokeWidth": 0.65
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "align": {
          "field": "align",
          "type": "nominal",
          "scale": null
        }
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}
