{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australias frog richness map",
  "title": {"text": "Frog species richness Average ","subtitle": " Area weighted average richness across mapped land","fontSize": 14,"subtitleFontSize": 11,"anchor": "start","fontWeight": "bold","color": "#173D3B", "offset": 12},
  "width": "container",
  "height": 490,
  "projection": {
    "type": "mercator","center": [134,-27],"scale": 620},
  "layer": [
    {"data": {"url": "data/states.geojson","format": {"type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/frog_atlas_mean_richness_by_state.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "state": "string",
                  "mean_mapped_richness": "number",
                  "atlas_coverage_pct": "number",
                  "mapped_area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "mean_mapped_richness",
              "atlas_coverage_pct",
              "mapped_area_km2"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.9
      },
      "encoding": {
        "color": {
          "field": "mean_mapped_richness",
          "type": "quantitative",
          "title": "Mean mapped species richness",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              20
            ],
            "range": ["#E8F3DC","#B7D9B0","#73B69B","#32877E","#154C52"]
          },
          "legend": {
            "orient": "right",
            "gradientLength": 200,
            "gradientThickness": 14,
            "titleFontSize": 11,
            "labelFontSize": 10,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "mean_mapped_richness",
            "type": "quantitative",
            "title": "Mean local mapped richness",
            "format": ".1f"
          },
          {
            "field": "atlas_coverage_pct",
            "type": "quantitative",
            "title": "Area covered by Atlas (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"state": "WA","lon": 121,
            "lat": -26
          },
          {"state": "NT","lon": 133,
            "lat": -20
          },
          {"state": "SA",
            "lon": 135,
            "lat": -30
          },
          {"state": "QLD",
            "lon": 144,
            "lat": -22
          },
          {"state": "NSW", "lon": 147,
            "lat": -32
          },
          {"state": "VIC", "lon": 144,"lat": -37
          },
          {"state": "TAS",
            "lon": 147,
            "lat": -42
          },
          { "state": "ACT",
            "lon": 150.3,
            "lat": -35.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#173D35",
        "opacity": 0.9,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}