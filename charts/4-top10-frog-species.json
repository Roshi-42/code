{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json","description": "The ten most frequently recorded frog species.",
  "width": "container",
  "height": 420,"data": {
    "url": "data/top10_species_national.csv"
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4,
    "color": "#32877E"
  },
  "encoding": {
    "y": {
      "field": "common_name",
      "type": "nominal",
      "title": null,
      "sort": "-x",
      "axis": {
        "labelFontSize": 11,
        "labelLimit": 0,
        "minExtent": 155,
        "maxExtent": 155
      }
    },
    "x": {
      "field": "records",
      "type": "quantitative",
      "title": "Number of FrogID occurrence records",
      "axis": {
        "format": "~s",
        "grid": true,
        "gridColor": "#E5EBE7",
        "tickCount": 5,
        "minExtent": 180,
        "maxExtent": 180
      }, "scale": {
        "zero": true }
    },
    
    "tooltip": 
    [
      {
        "field": "common_name","type": "nominal",
        "title": "Frog species"
      },
      {
        "field": "records","type": "quantitative","title": "Occurrence records",
        "format": ","
      }
    ]
  },
  "config": {
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  },
  "transform": [
    {
      "lookup": "species",
      "from": {
        "data": {
          "url": "data/frog_common_names.csv"
        },
        "key": "species",
        "fields": [
          "common_name"
        ]
      }
    }
  ],
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 60,
    "right": 5,
    "bottom": 5,
    "left": 5
  }
}
