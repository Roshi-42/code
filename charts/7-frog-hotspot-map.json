
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json","description": "FrogID occurrence record hotspots across Australia.",
  "width": "container","height": 460,

  "projection": {
    "type": "mercator",
    "center": [134, -27],
    "scale": 600
  },

  "layer": [
  

{
  "data": {
   "url": "data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
